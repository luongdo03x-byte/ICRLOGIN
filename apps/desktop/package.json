{
  "name": "@icrlogin/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "electron-vite build",
    "predev": "electron-rebuild -f -w better-sqlite3 -v 38.1.2",
    "dev": "electron-vite dev",
    "package:dir": "npm run build && electron-builder --dir --win --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:release": "npm run build && electron-builder --win nsis --x64 --publish never -c.forceCodeSigning=true"
  },
  "dependencies": {
    "@icrlogin/core": "0.1.0",
    "@icrlogin/shared": "0.1.0",
    "@tanstack/react-query": "^5.90.2",
    "better-sqlite3": "^12.4.1",
    "electron": "38.1.2",
    "electron-updater": "^6.8.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron-builder": "^26.16.1",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0"
  }
}
