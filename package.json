{
  "name": "icrlogin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint .",
    "verify:release-parity": "node tools/verify-release-parity.mjs",
    "test:integration:chromium": "npm run test:integration:chromium -w @icrlogin/core",
    "test:desktop:packaged": "node tools/electron-packaged-smoke.mjs",
    "package:dir": "npm run package:dir -w @icrlogin/desktop",
    "package:win": "npm run package:win -w @icrlogin/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "zod": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "playwright": "^1.55.0"
  }
}
